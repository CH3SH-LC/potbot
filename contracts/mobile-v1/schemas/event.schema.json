{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "contracts/mobile-v1/schemas/event.schema.json",
  "title": "Event",
  "description": "公共事件输出。冻结必需字段：eventId / seq / commandId / revision / status（resultRef 与 error 可选）。语义：同一 idempotencyKey 的重复命令必须返回原结果（幂等）；expectedRevision 与当前不符 ⇒ status=conflict（不是 succeeded）。fail-closed：status=succeeded 必须携带 resultRef；没有执行器/结果时内核只能上报 pending/running/failed，不得产出 succeeded。",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "seq", "commandId", "revision", "status"],
  "properties": {
    "eventId": { "$ref": "#/$defs/id" },
    "seq": { "type": "integer", "minimum": 0 },
    "commandId": { "$ref": "#/$defs/id" },
    "revision": { "$ref": "#/$defs/revision" },
    "status": { "$ref": "#/$defs/status" },
    "resultRef": { "type": "string", "minLength": 1 },
    "error": { "$ref": "#/$defs/error" },
    "verificationMode": { "$ref": "#/$defs/verificationMode" },
    "idempotentReplay": { "type": "boolean" },
    "metadata": { "type": "object" }
  },
  "allOf": [
    {
      "description": "succeeded 必须带 resultRef（fail-closed）；其余状态不需要。",
      "oneOf": [
        {
          "required": ["status", "resultRef"],
          "properties": { "status": { "const": "succeeded" } }
        },
        {
          "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/nonSuccessStatus" } }
        }
      ]
    }
  ],
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 0 },
    "status": {
      "enum": ["pending", "running", "succeeded", "failed", "conflict", "cancelled"]
    },
    "nonSuccessStatus": {
      "enum": ["pending", "running", "failed", "conflict", "cancelled"]
    },
    "verificationMode": { "enum": ["fixture", "real"] },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object" }
      }
    }
  }
}
