{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "skipLibCheck": true,

    "rootDir": ".",
    "outDir": ".runtime/mobile-word-demo/build",
    "noEmit": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["apps/demo", "src"]
}
